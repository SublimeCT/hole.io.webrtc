# `process.env` > `.env.local` > `.env`。不要提交真实凭据。
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# 生产环境请指定可信前端 origin。`pnpm dev:server` 会临时覆写为 `*` 以支持局域网调试。
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=127.0.0.1,::1

DATABASE_URL=

# 必须与 coturn 的 static-auth-secret 一致，至少 32 字符。
TURN_SECRET=
TURN_TTL_SECONDS=3600
TURN_REALM=
STUN_URIS=
TURN_URIS=
