# `process.env` > `.env.local` > `.env`。不要提交真实凭据。
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=127.0.0.1,::1

DATABASE_URL=postgresql://holeio:replace-with-a-strong-password@127.0.0.1:5432/holeio

# 必须与 coturn 的 static-auth-secret 一致，至少 32 字符。
TURN_SECRET=replace-with-at-least-32-random-characters
TURN_TTL_SECONDS=3600
TURN_REALM=hole.io
STUN_URIS=stun:localhost:3478
TURN_URIS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
